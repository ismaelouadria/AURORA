{
  "schema_version": 1,
  "id": "egg-opm-reference",
  "simulator": {
    "name": "OPM Flow",
    "preserved_verified_version": "2026.04",
    "role": "higher-fidelity numerical reference",
    "physical_ground_truth": false
  },
  "dataset": {
    "name": "Egg Model",
    "storage": "external-local",
    "bulk_files_committed": false,
    "required_entry_deck": "Egg_Model_ECL.DATA"
  },
  "execution": {
    "native_command": "flow <deck> --output-dir=<dir>",
    "docker_image": "openporousmedia/opmreleases:latest",
    "required_output_suffixes": [
      ".EGRID",
      ".INIT",
      ".SMSPEC",
      ".UNSMRY",
      ".UNRST"
    ],
    "success_requires": [
      "process_exit_status_zero",
      "required_output_files_present"
    ]
  },
  "claim_boundaries": [
    "OPM output is numerical reference evidence, not physical ground truth.",
    "A successful run does not validate controller observability.",
    "A generated quantity is not automatically an authorized controller input.",
    "The supplied Egg schedule spacing does not freeze AURORA control cadence."
  ]
}
